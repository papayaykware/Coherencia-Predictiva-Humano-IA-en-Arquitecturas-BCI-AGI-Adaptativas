# notebooks/04_tae_validation.ipynb

"""
Validación del Detector de Excepciones TAE
==========================================
Este notebook demuestra la funcionalidad del detector TAE con datos simulados.
"""

import numpy as np
import matplotlib.pyplot as plt
import sys
sys.path.append('../src')

from tae.exception_detector import TAEExceptionDetector
from tae.anomaly_classifier import AnomalyClassifier

# 1. Inicializar detector
detector = TAEExceptionDetector(window_size=50, lambda_threshold=1.5)

# 2. Simular flujo de datos EEG
np.random.seed(42)
n_samples = 500
eeg_signal = np.random.randn(n_samples, 4)  # 4 canales
icp_values = np.random.rand(n_samples)

# Introducir anomalía en la muestra 200-250
eeg_signal[200:250] += 5.0  # Ruido fuerte
icp_values[200:250] = 0.2   # Caída de ICP

# 3. Ejecutar detector
exceptions = []
for i in range(n_samples):
    event = detector.update(
        eeg_features=eeg_signal[i],
        icp_value=icp_values[i]
    )
    if event:
        exceptions.append(event)

# 4. Visualizar resultados
fig, axes = plt.subplots(3, 1, figsize=(12, 8))

axes[0].plot(icp_values, label='ICP')
axes[0].axvspan(200, 250, alpha=0.3, color='red', label='Anomalía')
axes[0].set_ylabel('ICP')
axes[0].legend()
axes[0].set_title('Evolución del ICP')

# Marcar excepciones detectadas
axes[1].plot([e.severity for e in exceptions], 'rx', markersize=8, label='Excepciones')
axes[1].set_ylabel('Severidad')
axes[1].set_xlabel('Muestra')
axes[1].legend()

# Histograma de tipos de excepción
classifier = AnomalyClassifier()
anomaly_counts = classifier.get_summary()
axes[2].bar(anomaly_counts.keys(), anomaly_counts.values())
axes[2].set_ylabel('Frecuencia')
axes[2].set_title('Tipos de Anomalías Detectadas')
plt.xticks(rotation=45)

plt.tight_layout()
plt.savefig('../docs/diagrams/tae_validation.png')
plt.show()

print(f"Total de excepciones detectadas: {len(exceptions)}")
print(f"Tasa de excepciones: {detector.get_exception_rate():.2f}/seg")
