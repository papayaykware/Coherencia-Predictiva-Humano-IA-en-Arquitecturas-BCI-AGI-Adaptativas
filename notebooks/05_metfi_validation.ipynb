# notebooks/05_metfi_validation.ipynb

"""
Validación del Módulo METFI
===========================
Demostración de integración de datos geomagnéticos y análisis de correlación.
"""

import numpy as np
import matplotlib.pyplot as plt
import sys
sys.path.append('../src')

from metfi.geomag_stream import GeomagneticDataStream, GeomagneticConfig
from metfi.correlation_analyzer import METFICorrelationAnalyzer
from metfi.schumann_detector import SchumannResonanceDetector

# 1. Inicializar componentes
geomag_stream = GeomagneticDataStream(GeomagneticConfig(update_interval=1.0))
analyzer = METFICorrelationAnalyzer(window_size=300, sample_rate=1.0)
schumann_detector = SchumannResonanceDetector(eeg_sample_rate=256.0)

# 2. Simular datos EEG y ICP
np.random.seed(42)
n_samples = 600  # 10 minutos a 1 muestra/seg
times = np.arange(n_samples)

# Simular ICP con correlación con Kp
kp_sim = 2.0 + 0.5 * np.sin(2 * np.pi * times / 300) + np.random.normal(0, 0.2, n_samples)
icp_sim = 0.6 + 0.15 * (kp_sim - 2.0) + np.random.normal(0, 0.1, n_samples)
icp_sim = np.clip(icp_sim, 0.2, 0.9)

# Simular EEG con resonancia Schumann
fs_eeg = 256.0
t_eeg = np.linspace(0, 10, int(fs_eeg * 10))  # 10 segundos
eeg_signal = (np.sin(2 * np.pi * 7.83 * t_eeg) +  # Resonancia fundamental
              0.5 * np.sin(2 * np.pi * 14.3 * t_eeg) +  # Primer overtone
              np.random.normal(0, 0.5, len(t_eeg)))

# 3. Detectar resonancias Schumann
schumann_result = schumann_detector.detect_resonance(eeg_signal, return_spectrum=True)

# 4. Ejecutar análisis de correlación
geomag_stream.start()
correlations = []

for i in range(n_samples):
    # Simular muestra geomagnética
    sample = geomag_stream._generate_simulated_data()
    sample.kp = kp_sim[i]
    sample.d_st = -20.0 * (kp_sim[i] - 2.0)
    
    # Actualizar analizador
    alpha_power = 0.5 + 0.1 * np.sin(2 * np.pi * i / 100)  # Simular potencia alpha
    result = analyzer.update(icp_sim[i], alpha_power, sample)
    if result:
        correlations.append(result)

# 5. Visualizar resultados
fig, axes = plt.subplots(3, 2, figsize=(14, 10))

# ICP vs Kp
axes[0,0].plot(times, kp_sim, label='Kp (geomagnético)', color='orange')
axes[0,0].set_ylabel('Índice Kp')
axes[0,0].legend()
axes[0,0].set_title('Actividad Geomagnética')

axes[0,1].plot(times, icp_sim, label='ICP', color='blue')
axes[0,1].set_ylabel('ICP')
axes[0,1].legend()
axes[0,1].set_title('Coherencia Predictiva')

# Correlación ICP-Kp a lo largo del tiempo
if correlations:
    corr_values = [c.get('icp_vs_kp', {}).get('correlation', 0) for c in correlations]
    axes[1,0].plot(corr_values, 'g-', linewidth=2)
    axes[1,0].axhline(y=0.4, color='r', linestyle='--', label='Umbral significativo')
    axes[1,0].set_ylabel('Correlación ICP-Kp')
    axes[1,0].set_xlabel('Ventana')
    axes[1,0].legend()
    axes[1,0].set_title('Evolución de Correlación ICP-Geomagnético')

# Espectro EEG con resonancias
freqs = schumann_result.get('frequencies', [])
psd = schumann_result.get('psd', [])
axes[1,1].plot(freqs, psd, 'b-')
axes[1,1].axvline(x=7.83, color='r', linestyle='--', label='7.83 Hz (Fundamental)')
axes[1,1].axvline(x=14.3, color='orange', linestyle='--', label='14.3 Hz (1er overtone)')
axes[1,1].axvline(x=20.8, color='green', linestyle='--', label='20.8 Hz (2do overtone)')
axes[1,1].set_xlim(0, 30)
axes[1,1].set_xlabel('Frecuencia (Hz)')
axes[1,1].set_ylabel('Densidad espectral')
axes[1,1].legend()
axes[1,1].set_title('Espectro EEG con Resonancias Schumann')

# Influencia geomagnética
influence_scores = [analyzer.get_geomagnetic_influence_score() for _ in range(len(correlations))]
axes[2,0].plot(influence_scores, 'purple', linewidth=2)
axes[2,0].set_ylabel('Influencia Geomagnética')
axes[2,0].set_xlabel('Ventana')
axes[2,0].set_title('Índice de Influencia METFI')

# Potencia relativa de resonancias
res_powers = schumann_result.get('resonance_powers', {})
names = list(res_powers.keys())
rel_powers = [res_powers[n]['relative_power'] * 100 for n in names]
snrs = [res_powers[n]['snr_db'] for n in names]

x = np.arange(len(names))
width = 0.35
axes[2,1].bar(x - width/2, rel_powers, width, label='Potencia Relativa (%)', color='skyblue')
axes[2,1].set_ylabel('Potencia Relativa (%)')
axes[2,1].set_xlabel('Resonancia')
axes[2,1].tick_params(axis='x', rotation=45)
axes[2,1].legend()

ax2 = axes[2,1].twinx()
ax2.bar(x + width/2, snrs, width, label='SNR (dB)', color='salmon')
ax2.set_ylabel('SNR (dB)')

plt.tight_layout()
plt.savefig('../docs/diagrams/metfi_validation.png')
plt.show()

# 6. Resumen de resultados
print("\n=== RESULTADOS METFI ===")
print(f"Índice de acoplamiento Schumann-EEG: {schumann_result['coupling_index']:.3f}")
print(f"Resonancia primaria detectada: {schumann_result['primary_resonance']}")
print(f"Correlación ICP-Kp última: {correlations[-1]['icp_vs_kp']['correlation']:.3f}")
print(f"Influencia geomagnética actual: {analyzer.get_geomagnetic_influence_score():.3f}")
