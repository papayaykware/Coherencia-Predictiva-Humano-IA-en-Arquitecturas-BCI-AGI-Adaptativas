# Celda de ejemplo en 03_adaptation.ipynb
# Simular 50 trials y observar evolución del ICP con y sin adaptación

from src.pipeline.run_pipeline import CPEAPipeline
import matplotlib.pyplot as plt
import numpy as np

# Inicializar pipeline
pipeline = CPEAPipeline("config/agi_config.yaml")

# Simular 50 trials
icp_scores = []
for trial in range(50):
    # Simular señal EEG (reemplazar con datos reales)
    synthetic_eeg = np.random.randn(1000)
    _, icp = pipeline.process_trial(synthetic_eeg)
    icp_scores.append(icp)
    
    if trial % 10 == 0:
        print(f"Trial {trial}: ICP = {icp:.4f}")

# Visualizar evolución
plt.figure(figsize=(10, 6))
plt.plot(icp_scores, marker='o', linestyle='-', linewidth=2)
plt.axhline(y=0.5, color='r', linestyle='--', label='Umbral de Coherencia Mínimo')
plt.xlabel('Número de Trial')
plt.ylabel('Índice de Coherencia Predictiva (ICP)')
plt.title('Evolución del ICP con Fine-Tuning Online (LoRA)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

print(f"ICP Final: {icp_scores[-1]:.4f}")
print(f"Mejora respecto a inicio: {icp_scores[-1] - icp_scores[0]:.4f}")
