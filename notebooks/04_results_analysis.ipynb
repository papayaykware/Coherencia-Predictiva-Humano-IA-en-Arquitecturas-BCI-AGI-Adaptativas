# Análisis de Resultados del Experimento Simulado CPEA

Este notebook analiza los datos del primer experimento simulado, comparando condiciones **baseline** vs **adaptativa** en 10 sujetos sintéticos.

## 1. Cargar Datos y Configuración

```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
from pathlib import Path
import json

# Estilo de gráficos
sns.set_theme(style="whitegrid")
plt.rcParams['figure.figsize'] = (12, 6)

# 2. Cargar el archivo de resultados más reciente
results_dir = Path('../results')
metrics_files = sorted(results_dir.glob('experiment_metrics_*.csv'))
if not metrics_files:
    raise FileNotFoundError("No se encontraron archivos de resultados en ../results/")

latest_metrics = metrics_files[-1]
trials_file = latest_metrics.stem.replace('metrics', 'trials') + '.csv'
config_file = latest_metrics.stem.replace('metrics', 'config') + '.json'

metrics_df = pd.read_csv(latest_metrics)
trials_df = pd.read_csv(results_dir / trials_file)
with open(results_dir / config_file, 'r') as f:
    config = json.load(f)

print(f"Analizando experimento: {latest_metrics.name}")
print(f"Configuración: {config}")
# Resumen por condición
summary = metrics_df.groupby('condition').agg({
    'accuracy_mean': ['mean', 'std'],
    'latency_mean': ['mean', 'std'],
    'mi_mean': ['mean', 'std'],
    'icp': ['mean', 'std']
}).round(4)
print("Estadísticas por condición:")
print(summary)

# 3. Separar datos por condición
baseline = metrics_df[metrics_df['condition'] == 'baseline']
adaptive = metrics_df[metrics_df['condition'] == 'adaptive']

# Alinear por subject_id para pruebas pareadas
paired_data = pd.merge(
    baseline[['subject_id', 'accuracy_mean', 'latency_mean', 'mi_mean', 'icp']],
    adaptive[['subject_id', 'accuracy_mean', 'latency_mean', 'mi_mean', 'icp']],
    on='subject_id',
    suffixes=('_base', '_adapt')
)

# t-test pareado para cada métrica
metrics_to_test = ['accuracy_mean', 'latency_mean', 'mi_mean', 'icp']
results = {}
for metric in metrics_to_test:
    base_vals = paired_data[f'{metric}_base']
    adapt_vals = paired_data[f'{metric}_adapt']
    t_stat, p_val = stats.ttest_rel(base_vals, adapt_vals)
    cohen_d = (adapt_vals.mean() - base_vals.mean()) / base_vals.std()
    results[metric] = {'t_stat': t_stat, 'p_val': p_val, 'cohen_d': cohen_d}
    print(f"{metric}: t={t_stat:.3f}, p={p_val:.5f}, d={cohen_d:.3f}")

# Interpretación de significancia
alpha = 0.05
significant = {k: v['p_val'] < alpha for k, v in results.items()}
print("\nMejora significativa (p < 0.05):", significant)

# Figura 1: Comparación de métricas por condición (boxplots)
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
metrics_plot = ['accuracy_mean', 'latency_mean', 'mi_mean', 'icp']
titles = ['Accuracy', 'Latencia (s)', 'Información Mutua (bits)', 'Índice ICP']

for ax, metric, title in zip(axes.flat, metrics_plot, titles):
    sns.boxplot(data=metrics_df, x='condition', y=metric, ax=ax, palette='Set2')
    ax.set_title(title)
    ax.set_ylabel('')
    if metric == 'accuracy_mean':
        ax.set_ylim(0.5, 1.0)
    elif metric == 'latency_mean':
        ax.set_ylim(1, 3.5)
    elif metric == 'mi_mean':
        ax.set_ylim(0.2, 0.7)
    elif metric == 'icp':
        ax.set_ylim(0, 1)
    # Añadir estrellas de significancia
    if significant.get(metric, False):
        ax.text(0.5, 0.95, '***', transform=ax.transAxes, ha='center', fontsize=14)
plt.tight_layout()
plt.savefig('../results/comparison_boxplots.png', dpi=150)
plt.show()

# Figura 2: Evolución del ICP por sujeto (líneas pareadas)
plt.figure(figsize=(12, 6))
for _, row in paired_data.iterrows():
    plt.plot(['baseline', 'adaptive'], [row['icp_base'], row['icp_adapt']], 
             'o-', color='gray', alpha=0.5, markersize=6)
plt.plot([0,1], [paired_data['icp_base'].mean(), paired_data['icp_adapt'].mean()], 
         'ro-', linewidth=2, markersize=10, label='Media grupal')
plt.xticks([0,1], ['Baseline', 'Adaptativa'])
plt.ylabel('Índice de Coherencia Predictiva (ICP)')
plt.title('Evolución del ICP por sujeto (líneas pareadas)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('../results/icp_individual_evolution.png', dpi=150)
plt.show()

# Figura 3: Distribución de ganancias adaptativas
plt.figure(figsize=(12, 5))
plt.subplot(1, 2, 1)
gains_acc = paired_data['accuracy_mean_adapt'] - paired_data['accuracy_mean_base']
plt.hist(gains_acc, bins=10, edgecolor='black', alpha=0.7)
plt.axvline(gains_acc.mean(), color='red', linestyle='--', label=f'Media = {gains_acc.mean():.3f}')
plt.xlabel('Ganancia en Accuracy')
plt.ylabel('Frecuencia')
plt.title('Distribución de mejora en Accuracy')
plt.legend()

plt.subplot(1, 2, 2)
gains_icp = paired_data['icp_adapt'] - paired_data['icp_base']
plt.hist(gains_icp, bins=10, edgecolor='black', alpha=0.7, color='green')
plt.axvline(gains_icp.mean(), color='red', linestyle='--', label=f'Media = {gains_icp.mean():.3f}')
plt.xlabel('Ganancia en ICP')
plt.ylabel('Frecuencia')
plt.title('Distribución de mejora en ICP')
plt.legend()
plt.tight_layout()
plt.savefig('../results/adaptive_gains_distribution.png', dpi=150)
plt.show()

# Matriz de correlación entre métricas (para condición adaptativa)
adaptive_metrics = metrics_df[metrics_df['condition'] == 'adaptive'][['accuracy_mean', 'latency_mean', 'mi_mean', 'icp']]
corr_matrix = adaptive_metrics.corr()

plt.figure(figsize=(8, 6))
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', center=0, fmt='.3f')
plt.title('Correlación entre métricas (condición adaptativa)')
plt.tight_layout()
plt.savefig('../results/correlation_matrix.png', dpi=150)
plt.show()

print("Correlación más fuerte observada:")
print(corr_matrix.unstack().sort_values(ascending=False).drop_duplicates().head(3))
