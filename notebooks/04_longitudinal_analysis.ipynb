# 5. Curva de aprendizaje: ICP medio por bloque a lo largo de sesiones
# (requiere extraer datos por bloque)
block_means = []
for session in long_df['session_id']:
    icp_file = os.path.join(base_path, session, "icp.csv")
    df = pd.read_csv(icp_file)
    block_means.append(df.groupby('block')['icp'].mean().values)

# Graficar evolución por bloque
plt.figure()
for i, means in enumerate(block_means):
    plt.plot(means, marker='o', label=f"Sesión {i+1}")
plt.xlabel("Bloque")
plt.ylabel("ICP medio")
plt.legend()
plt.title("Evolución del ICP por bloque en sesiones consecutivas")
plt.grid(True)
plt.show()
